# Copy to infra/.env and fill in. Nothing here has a working default on purpose: a secret with a
# default is a secret that ships.
#
# Generate the values:
#   POSTGRES_PASSWORD / PORTAL_DB_PASSWORD / REDIS_PASSWORD / MINIO_ROOT_PASSWORD
#     These are interpolated into connection strings such as
#     postgres://attestor:${POSTGRES_PASSWORD}@postgres:5432/attestor, so they must not contain
#     characters that mean something in a URL. Plain base64 emits '/' and '+', and a password
#     containing '/' ends early — the connection then fails with an authentication error that looks
#     nothing like its cause. Use a URL-safe alphabet:
#     openssl rand -base64 48 | tr -d '/+=' | head -c 32
#   SESSION_SECRET
#     Never appears in a URL, so plain base64 is fine:
#     openssl rand -base64 32
#   VAULT_MASTER_KEY
#     node -e "import('libsodium-wrappers-sumo').then(async s=>{await s.default.ready;console.log(s.default.to_base64(s.default.randombytes_buf(32),s.default.base64_variants.ORIGINAL))})"

NODE_ENV=development
LOG_LEVEL=info

# Databases -------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
# The portal connects as attestor_portal, a least-privilege role created by migration 0001. Set its
# password with: ALTER ROLE attestor_portal WITH LOGIN PASSWORD '…';
PORTAL_DB_PASSWORD=
REDIS_PASSWORD=

# Object storage --------------------------------------------------------------------------------
MINIO_ROOT_USER=attestor
MINIO_ROOT_PASSWORD=
# Built-in KMS key for server-side encryption of the evidence and report buckets.
# Generate with: openssl rand -base64 32
MINIO_KMS_SECRET_KEY=attestor-key:
S3_REGION=us-east-1
S3_BUCKET_EVIDENCE=attestor-evidence
S3_BUCKET_REPORTS=attestor-reports

# Secrets ---------------------------------------------------------------------------------------
# 32 bytes, base64. Per-engagement subkeys are derived from this; losing it makes every stored
# credential unrecoverable, which is by design. Back it up separately from the database.
VAULT_MASTER_KEY=
# A second 32-byte base64 key, for client authenticator secrets only. Separate from the vault key
# because the portal has to decrypt these on every sign-in and must never be able to decrypt a
# client credential. Generate it the same way as VAULT_MASTER_KEY. Rotating it needs a re-wrap pass
# with both keys present or every client is locked out; docs/RUNBOOK.md section 4.3.
PORTAL_TOTP_KEY=
SESSION_SECRET=

# Origins ---------------------------------------------------------------------------------------
CONSOLE_ORIGIN=http://localhost:3000
PORTAL_ORIGIN=http://localhost:3100
# The console API binds to loopback. In production it is reached over WireGuard and this must never
# be 0.0.0.0 — the server refuses to start if it is.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
PORTAL_API_PORT=8081
# Set to 127.0.0.1 to keep the portal on loopback during development.
PORTAL_BIND=0.0.0.0

# Mail ------------------------------------------------------------------------------------------
# Local development captures mail in Mailpit at http://localhost:8025 and sends nothing.
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Attestor Security <no-reply@attestorsecurity.com>

# AI layer --------------------------------------------------------------------------------------
# Off by default. The whole system works with this false; turning it on is a per-engagement
# decision, and even then only redacted findings text is sent.
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL_DRAFTING=claude-sonnet-5
AI_MODEL_TRIAGE=claude-haiku-4-5-20251001
AI_MONTHLY_BUDGET_USD=0
# List prices, for the cost estimate in the usage log only. The invoice is the truth.
AI_INPUT_COST_PER_MILLION_USD=3
AI_OUTPUT_COST_PER_MILLION_USD=15

# Egress ----------------------------------------------------------------------------------------
# The fixed source address clients allowlist. Recorded on every authorisation.
EGRESS_IP=

DOCKER_SOCKET=/var/run/docker.sock
# The group that owns the Docker socket, added to the worker so it can reach it without running as
# root. 0 is correct on Docker Desktop, where the socket is root:root. On a Linux host it is usually
# root:docker — read it with:  stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=0

---
import BaseLayout from '../layouts/base-layout.astro';
import CommandPalette from '../components/command-palette.astro';
import { site } from '../data/site';

/**
 * Booking first, form second. A security buyer would rather book a call than fill in a form, and
 * the form exists for the people who want to send a scope in writing at midnight.
 *
 * There are no file uploads anywhere on this site. Not for scope documents, not for RFPs. A public
 * upload endpoint on a security firm's marketing site is a liability with no upside.
 */
---

<BaseLayout
  title="Contact"
  description="Book a 30-minute scoping call with Attestor Security, or send the scope in writing. Fixed price and dates back the same day."
  path="/contact"
>
  <section class="section">
    <div class="page split">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Thirty minutes, then a price</h1>
        <p class="lede">
          The call is scoping, not sales. Bring the application, the roles and the deadline; you get
          a written scope and a fixed number back the same day.
        </p>
        <p class="cta">
          <a class="button" href={site.bookingUrl} rel="noopener">Book the call</a>
        </p>
        <p class="direct">
          Or write to <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
        </p>

        <div class="panel-sunk prep">
          <h2>What to have ready</h2>
          <ul>
            <li>What is being tested and roughly how big it is.</li>
            <li>How many user roles, and whether there are multiple customer tenants.</li>
            <li>Whether we are testing staging or production.</li>
            <li>What is driving the date — a buyer, an auditor, an insurer, a release.</li>
            <li>Whether anything in scope is hosted or operated by somebody else.</li>
          </ul>
          <p>
            If you do not know some of these, that is fine. Not knowing is a normal starting point
            and working it out is part of the call.
          </p>
        </div>

        <div class="panel-sunk security-note">
          <h2>Reporting a security issue with our own systems</h2>
          <p>
            Write to <a href={`mailto:${site.securityContactEmail}`}>{site.securityContactEmail}</a>.
            Our <a href="/legal/responsible-disclosure">responsible disclosure policy</a> sets out
            what is in scope and what we ask.
          </p>
        </div>
      </div>

      <div>
        <form class="enquiry" method="POST" action={site.formEndpoint} data-enquiry>
          <h2>Send the scope in writing</h2>

          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
          </div>

          <div class="field">
            <label for="email">Work email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="200"
            />
          </div>

          <div class="field">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" autocomplete="organization" required maxlength="150" />
          </div>

          <div class="field">
            <label for="message">What needs testing, and by when?</label>
            <textarea id="message" name="message" rows="7" required maxlength="4000"></textarea>
          </div>

          <div class="honeypot" aria-hidden="true">
            <label for="company-website">Leave this field empty</label>
            <input id="company-website" name="companyWebsite" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="turnstile" data-turnstile-mount>
            <p class="turnstile-note">
              A challenge from Cloudflare Turnstile loads here on the deployed site. It sets no
              tracking cookie and profiles nobody.
            </p>
          </div>

          <button type="submit" class="button">Send</button>

          <p class="form-status" data-form-status role="status" aria-live="polite"></p>

          <p class="form-fine">
            We use what you send to answer your enquiry and to prepare a proposal, nothing else. See
            the <a href="/legal/privacy">privacy notice</a>. No files can be attached here by design.
          </p>
        </form>
      </div>
    </div>
  </section>

  <CommandPalette />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  if (form && status) {
    // Carry the estimator's selections through, so somebody who used it does not retype the scope.
    const scope = new URLSearchParams(window.location.search).get('scope');
    if (scope) {
      const message = form.elements.namedItem('message') as HTMLTextAreaElement;
      if (!message.value) message.value = `Scope from the estimator: ${scope}\n\n`;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      button.disabled = true;
      status.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        status.textContent =
          'Sent. You will get a reply within one working day, from a person, not an autoresponder.';
      } catch {
        status.textContent = `That did not send. Email ${form.dataset.fallback ?? 'hello@attestorsecurity.com'} instead and we will pick it up.`;
        button.disabled = false;
      }
    });
  }
</script>

<style>
  h1 {
    max-width: 14ch;
  }

  .cta {
    margin-top: var(--space-m);
  }

  .direct {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .prep,
  .security-note {
    margin-top: var(--space-l);
  }

  .prep h2,
  .security-note h2,
  .enquiry h2 {
    font-family: var(--font-body);
    font-size: var(--step-0);
    margin-bottom: var(--space-2xs);
  }

  .prep ul {
    font-size: var(--step--1);
    padding-left: 1.1rem;
  }

  .prep p,
  .security-note p {
    font-size: var(--step--1);
    margin-bottom: 0;
  }

  .enquiry {
    border: 1px solid var(--rule);
    background: var(--ground-raised);
    padding: var(--space-m);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: var(--space-s);
  }

  .field label {
    font-size: var(--step--1);
    font-weight: 600;
  }

  input,
  textarea {
    border: 1px solid var(--rule-strong);
    background: var(--ground);
    padding: 0.5rem 0.6rem;
    font-size: var(--step-0);
    width: 100%;
    font-family: inherit;
  }

  textarea {
    resize: vertical;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .turnstile-note {
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin: 0 0 var(--space-s);
  }

  .form-status {
    margin: var(--space-s) 0 0;
    font-size: var(--step--1);
    color: var(--accent-deep);
  }

  .form-fine {
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin: var(--space-s) 0 0;
  }
</style>

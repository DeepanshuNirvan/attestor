---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/base-layout.astro';
import CommandPalette from '../../components/command-palette.astro';
import { readingMinutes } from '../../data/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => data.published);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const topHeadings = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  path={`/insights/${post.id}`}
  ogImage={`/og/insights-${post.id}.png`}
>
  <article class="section">
    <div class="page">
      <header class="article-head">
        <p class="post-meta">
          <time datetime={post.data.publishedAt.toISOString()}>
            {dateFormat.format(post.data.publishedAt)}
          </time>
          <span aria-hidden="true"> · </span>
          <span>{readingMinutes(post.body ?? '')} min read</span>
          {
            post.data.updatedAt && (
              <>
                <span aria-hidden="true"> · </span>
                <span>updated {dateFormat.format(post.data.updatedAt)}</span>
              </>
            )
          }
        </p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.summary}</p>
        <p class="post-tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</p>
      </header>

      {
        topHeadings.length > 2 && (
          <nav class="toc" aria-label="Contents">
            <p class="toc-label">Contents</p>
            <ol>
              {topHeadings.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="prose article-body">
        <Content />
      </div>

      <footer class="article-foot">
        <p>
          Written by the person who does the testing. If something here is wrong, say so — the
          correction is more useful than the original.
        </p>
        <p><a class="button" href="/contact">Book a scoping call</a></p>
      </footer>
    </div>
  </article>

  <CommandPalette />
</BaseLayout>

<style>
  .article-head {
    max-width: var(--width-prose);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-m);
  }

  .post-meta {
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.4rem;
  }

  h1 {
    font-size: var(--step-3);
    max-width: 22ch;
  }

  .post-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    max-width: none;
    margin-bottom: 0;
  }

  .toc {
    max-width: var(--width-prose);
    margin-top: var(--space-l);
    padding: var(--space-s) var(--space-m);
    border-left: 2px solid var(--accent);
    background: var(--ground-sunk);
  }

  .toc-label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.3rem;
  }

  .toc ol {
    margin: 0;
    padding-left: 1.1rem;
    font-size: var(--step--1);
  }

  .article-body {
    margin-top: var(--space-l);
  }

  .article-body :global(h2) {
    font-size: var(--step-2);
    margin-top: var(--space-xl);
    scroll-margin-top: 5.5rem;
  }

  .article-body :global(h3) {
    font-size: var(--step-1);
    font-family: var(--font-body);
    margin-top: var(--space-l);
  }

  .article-body :global(blockquote) {
    font-size: var(--step-0);
  }

  .article-foot {
    max-width: var(--width-prose);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
</style>

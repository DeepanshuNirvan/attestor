---
import BaseLayout from '../layouts/base-layout.astro';
import ScopeEstimator from '../components/scope-estimator.astro';
import EngagementTimeline from '../components/engagement-timeline.astro';
import CommandPalette from '../components/command-palette.astro';
import OrganizationJsonLd from '../components/organization-json-ld.astro';
import { packages, formatMoney } from '../data/pricing';
import { site } from '../data/site';
import { checkCatalogue } from '@attestor/findings/catalogue';

const headline = packages.filter((item) =>
  ['web-standard', 'cloud-review', 'mobile', 'llm-standalone'].includes(item.id),
);

const notDoing = [
  'Guarantee that a system is secure. Nobody can. A report that says so will not help you with an auditor.',
  'Certify anything. We are not an accreditation body and we are not CERT-In empanelled.',
  'Test an asset you do not own, without written permission from the owner.',
  'Start work without a signed authorisation naming the exact assets and the exact dates.',
  'Run denial-of-service, load or volumetric tests. Our platform has no setting that allows it.',
  'Fix the code we audited. If we fixed it, we could not independently assess it.',
];
---

<BaseLayout
  title="Independent security assessment"
  description={site.description}
  path="/"
>
  <OrganizationJsonLd slot="head" />

  <section class="hero">
    <div class="page">
      <p class="eyebrow">Security assessment · India and international</p>
      <h1>Security testing with a fixed price and a fixed date.</h1>
      <p class="hero-lede">
        We test web applications, APIs, cloud accounts, mobile apps and LLM features. You get a
        report your customer's security team can check, one free retest, and a one-page letter you
        can forward without sharing the findings themselves. Prices are published below.
      </p>
      <p class="hero-actions">
        <a class="button" href="/contact">Book a scoping call</a>
        <a class="button button-quiet" href="/sample-report">Read the sample report</a>
        <a class="button button-quiet" href="#estimator">Estimate the price</a>
      </p>
      <dl class="hero-facts">
        <div>
          <dt>Web application audit</dt>
          <dd class="numeric">{formatMoney(packages.find((item) => item.id === 'web-standard')!.price.INR, 'INR')}</dd>
          <dd class="hero-fact-note">5 working days</dd>
        </div>
        <div>
          <dt>Retest</dt>
          <dd>Included</dd>
          <dd class="hero-fact-note">Within {site.freeRetestWindowDays} days, in writing</dd>
        </div>
        <div>
          <dt>Checks in the catalogue</dt>
          <dd class="numeric">{checkCatalogue.length}</dd>
          <dd class="hero-fact-note"><a href="/what-we-test">Every one of them, listed</a></dd>
        </div>
        <div>
          <dt>Evidence deleted after</dt>
          <dd class="numeric">{site.evidenceRetentionDays} days</dd>
          <dd class="hero-fact-note">With written confirmation</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="why-heading">
    <div class="page split">
      <div>
        <p class="eyebrow">How we work</p>
        <h2 id="why-heading">Tools find candidates. People confirm them.</h2>
      </div>
      <div class="stack">
        <p>
          You can buy a scanner yourself for about ninety dollars a month. What a scanner cannot do
          is decide whether a result is real, work out what three small problems add up to when
          combined, or check whether your support staff can read an enterprise customer's data.
        </p>
        <p>
          We automate the repetitive parts: discovery, scanning, evidence capture and report
          assembly. That is why a web application audit takes five days instead of three weeks. A
          tester reproduced every finding in your report before it was written down. If a tool
          reported something and we could not reproduce it, it is not in the report.
        </p>
        <ul class="rule-list">
          <li>
            <strong>We check findings before we send them.</strong> Scanner output is typically 40
            to 70% false positives. Sorting that out is our job, not yours.
          </li>
          <li>
            <strong>One cause is one finding.</strong> A missing header on forty endpoints is one
            finding listing forty assets, not forty tickets for your team.
          </li>
          <li>
            <strong>Fixes are written for your stack.</strong> Not "sanitise all input", but the
            change to make, where to make it, and why that is the right fix.
          </li>
          <li>
            <strong>A person writes the attack narrative.</strong> It shows how a small disclosure
            and a weak permission check combine into a serious problem. No tool writes that.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="page">
      <p class="eyebrow">Services</p>
      <h2 id="services-heading">What we test</h2>
      <ul class="service-grid">
        {
          headline.map((item) => (
            <li>
              <h3>{item.name}</h3>
              <p class="service-price numeric">
                {formatMoney(item.price.INR, 'INR')}
                <span class="service-price-alt"> · {formatMoney(item.price.USD, 'USD')}</span>
              </p>
              <p class="service-days">{item.turnaroundDays} working days</p>
              <p>{item.summary}</p>
            </li>
          ))
        }
      </ul>
      <p class="service-more">
        <a href="/services">Every service in detail</a> ·
        <a href="/pricing">The full price sheet</a> ·
        <a href="/what-we-test">The complete check catalogue</a>
      </p>
    </div>
  </section>

  <ScopeEstimator />

  <section class="section" aria-labelledby="timeline-section-heading">
    <div class="page">
      <p class="eyebrow">The engagement</p>
      <h2 id="timeline-section-heading" class="visually-hidden">Engagement timeline</h2>
      <EngagementTimeline compact />
      <p class="service-more"><a href="/how-we-work">Methodology, safety controls and what we will not do</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="honest-heading">
    <div class="page split">
      <div>
        <p class="eyebrow">Limits</p>
        <h2 id="honest-heading">What we will not do</h2>
      </div>
      <div>
        <ul class="rule-list">{notDoing.map((item) => <li>{item}</li>)}</ul>
        <div class="panel-sunk empanelment">
          <h3>On CERT-In empanelment</h3>
          <p>
            {site.brandName} is not CERT-In empanelled. If you are a bank, an NBFC, a payment
            aggregator, a SEBI-regulated entity, an insurer or a government body, your statutory
            audit has to be done by an empanelled organisation, and we cannot do it. We can do the
            testing beforehand and verify your fixes, so that audit passes first time. If another
            firm tells you they are empanelled, you can confirm it on the CERT-In site in under a
            minute. It is worth doing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="international-heading">
    <div class="page split">
      <div>
        <p class="eyebrow">Working with us from abroad</p>
        <h2 id="international-heading">Common questions from overseas clients</h2>
      </div>
      <dl class="qa">
        <dt>What are your overlap hours?</dt>
        <dd>
          {site.overlapHours.usEastern} with US Eastern, and {site.overlapHours.unitedKingdom} with
          the UK. Calls are booked in your timezone.
        </dd>
        <dt>Who holds our credentials, and for how long?</dt>
        <dd>
          You send them through a one-time link into an encrypted vault, never by email or chat.
          They are destroyed when the engagement closes. Rotate them anyway once we are done.
        </dd>
        <dt>What happens to the evidence?</dt>
        <dd>
          It is masked as we capture it, encrypted while stored, and deleted
          {site.evidenceRetentionDays} days after we release the report. You get a written deletion
          confirmation to keep on file.
        </dd>
        <dt>Are you insured?</dt>
        <dd>
          {
            site.professionalIndemnity.awaitingOwner
              ? 'Professional indemnity cover is being arranged; the cover amount will be published here and named in the engagement documents.'
              : `Professional indemnity cover of ${site.professionalIndemnity.coverAmount}, named in the engagement documents.`
          }
        </dd>
        <dt>Will you sign our data processing agreement?</dt>
        <dd>
          Yes. We also have our own, if you would rather start from a draft. We act as a processor,
          and the obligations are written down rather than assumed.
        </dd>
      </dl>
    </div>
  </section>

  <section class="section closing" aria-labelledby="closing-heading">
    <div class="page">
      <h2 id="closing-heading">Send us the scope and we will price it the same day.</h2>
      <p class="lede">
        One thirty-minute call, then a written scope, a price and a date. No long sales process.
      </p>
      <p class="hero-actions">
        <a class="button" href="/contact">Book a scoping call</a>
        <a class="button button-quiet" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      </p>
    </div>
  </section>

  <CommandPalette />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    max-width: 20ch;
    margin-bottom: var(--space-m);
  }

  .hero-lede {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
    max-width: none;
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-m);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .hero-facts dt {
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .hero-facts dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.1;
  }

  .hero-fact-note {
    font-family: var(--font-body) !important;
    font-size: 0.8rem !important;
    font-weight: 400 !important;
    color: var(--ink-muted);
    margin-top: 0.15rem !important;
  }

  .service-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-l);
  }

  /*
   * A card is a bordered box with one internal rhythm, not a stack of loose paragraphs under a
   * rule. Flex column with the summary pushed to the bottom keeps the price and the day count on
   * the same line across the row however long a name runs.
   */
  .service-grid li {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-top: 2px solid var(--ink);
    background: var(--ground-raised);
    padding: var(--space-s) var(--space-s) var(--space-m);
    max-width: none;
  }

  .service-grid h3 {
    font-size: var(--step-1);
    margin-bottom: 0.25rem;
  }

  .service-price {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    margin: 0;
  }

  .service-price-alt {
    font-size: var(--step--1);
    color: var(--ink-faint);
    font-weight: 400;
  }

  .service-days {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-faint);
    margin: 0.1rem 0 var(--space-2xs);
  }

  .service-grid p:last-child {
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin: var(--space-2xs) 0 0;
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }

  .service-more {
    margin-top: var(--space-l);
    font-size: var(--step--1);
  }

  .empanelment {
    margin-top: var(--space-l);
  }

  .empanelment h3 {
    font-family: var(--font-body);
    font-size: var(--step-0);
    margin-bottom: 0.3rem;
  }

  .empanelment p {
    margin: 0;
    font-size: var(--step--1);
  }

  .qa dt {
    font-weight: 600;
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }

  .qa dt:first-child {
    margin-top: 0;
    border-top: 0;
    padding-top: 0;
  }

  .qa dd {
    margin: 0.35rem 0 0;
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .closing h2 {
    max-width: 24ch;
  }
</style>

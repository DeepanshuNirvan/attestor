---
/**
 * Command-K search over the whole site, backed by Pagefind's static index. There is no server and
 * no third-party search service; the index is generated at build time and shipped with the site.
 *
 * The audience is technical, so the keyboard path is the primary one: ⌘K or Ctrl-K to open, arrows
 * to move, Enter to go, Escape to close.
 */
---

<dialog class="palette" data-command-palette aria-label="Search">
  <form method="dialog" class="palette-form" data-command-form>
    <label class="visually-hidden" for="palette-input">Search this site</label>
    <input
      id="palette-input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search services, checks and write-ups"
      data-command-input
    />
    <button type="submit" class="palette-close" aria-label="Close search">Esc</button>
  </form>
  <p class="palette-status" data-command-status role="status">Type to search.</p>
  <ul class="palette-results" data-command-results></ul>
</dialog>

<script>
  interface PagefindResultData {
    url: string;
    meta: { title?: string };
    excerpt: string;
  }
  interface PagefindResult {
    id: string;
    data: () => Promise<PagefindResultData>;
  }
  interface PagefindApi {
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-command-palette]');
  const input = document.querySelector<HTMLInputElement>('[data-command-input]');
  const list = document.querySelector<HTMLUListElement>('[data-command-results]');
  const status = document.querySelector<HTMLElement>('[data-command-status]');

  if (dialog && input && list && status) {
    let pagefind: PagefindApi | null = null;
    let loading: Promise<void> | null = null;
    let sequence = 0;

    // Built by the `pagefind` step after `astro build`, so it does not exist at compile time.
    // Held in a variable so neither TypeScript nor the bundler tries to resolve it.
    const indexUrl = '/_pagefind/pagefind.js';

    async function ensureIndex(): Promise<void> {
      if (pagefind || loading) return loading ?? Promise.resolve();
      loading = (async () => {
        try {
          pagefind = (await import(/* @vite-ignore */ indexUrl)) as PagefindApi;
        } catch {
          status!.textContent = 'Search index is only available in the built site.';
        }
      })();
      return loading;
    }

    function open(): void {
      if (!dialog!.open) dialog!.showModal();
      input!.focus();
      input!.select();
      void ensureIndex();
    }

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        open();
        return;
      }
      if (event.key === '/' && document.activeElement === document.body) {
        event.preventDefault();
        open();
      }
    });

    for (const trigger of document.querySelectorAll('[data-command-trigger]')) {
      trigger.addEventListener('click', open);
    }

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    let debounce: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(debounce);
      debounce = window.setTimeout(() => void run(input!.value.trim()), 120);
    });

    async function run(query: string): Promise<void> {
      const ticket = ++sequence;
      if (query.length < 2) {
        list!.replaceChildren();
        status!.textContent = 'Type to search.';
        return;
      }
      await ensureIndex();
      if (!pagefind) return;

      status!.textContent = 'Searching…';
      const search = await pagefind.search(query);
      if (ticket !== sequence) return;

      const top = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));
      if (ticket !== sequence) return;

      list!.replaceChildren(
        ...top.map((entry) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = entry.url;
          const title = document.createElement('span');
          title.className = 'palette-title';
          title.textContent = entry.meta.title ?? entry.url;
          const excerpt = document.createElement('span');
          excerpt.className = 'palette-excerpt';
          excerpt.innerHTML = entry.excerpt;
          link.append(title, excerpt);
          item.append(link);
          return item;
        }),
      );

      status!.textContent =
        top.length === 0 ? `Nothing found for “${query}”.` : `${top.length} result${top.length === 1 ? '' : 's'}`;
    }

    list.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      const links = [...list!.querySelectorAll('a')];
      const index = links.indexOf(document.activeElement as HTMLAnchorElement);
      const next = event.key === 'ArrowDown' ? index + 1 : index - 1;
      links[Math.max(0, Math.min(links.length - 1, next))]?.focus();
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        list!.querySelector('a')?.focus();
      }
    });
  }
</script>

<style>
  .palette {
    width: min(38rem, calc(100vw - 2rem));
    max-height: min(32rem, 80vh);
    padding: 0;
    border: 1px solid var(--rule-strong);
    background: var(--ground-raised);
    color: var(--ink);
    margin-top: 12vh;
  }

  .palette::backdrop {
    background: rgb(20 22 26 / 0.35);
  }

  .palette-form {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    border-bottom: 1px solid var(--rule);
    padding: var(--space-s) var(--space-m);
  }

  .palette-form input {
    flex: 1;
    border: 0;
    background: none;
    font-size: var(--step-1);
    padding: 0.2rem 0;
  }

  .palette-form input:focus-visible {
    outline: none;
  }

  .palette-close {
    background: none;
    border: 1px solid var(--rule);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.15rem 0.4rem;
    cursor: pointer;
  }

  .palette-status {
    margin: 0;
    padding: var(--space-2xs) var(--space-m);
    font-size: 0.78rem;
    color: var(--ink-faint);
    border-bottom: 1px solid var(--rule);
  }

  .palette-results {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
  }

  .palette-results li {
    max-width: none;
    border-bottom: 1px solid var(--rule);
  }

  .palette-results a {
    display: block;
    padding: var(--space-s) var(--space-m);
    text-decoration: none;
    color: inherit;
  }

  .palette-results a:hover,
  .palette-results a:focus-visible {
    background: var(--accent-wash);
  }

  .palette-title {
    display: block;
    font-weight: 600;
    font-size: var(--step-0);
  }

  .palette-excerpt {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin-top: 0.2rem;
  }

  .palette-excerpt :global(mark) {
    background: var(--accent-wash);
    color: var(--accent-deep);
    padding: 0 0.1em;
  }
</style>

---
import { site } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/services', label: 'Services' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/sample-report', label: 'Sample report' },
  { href: '/how-we-work', label: 'How we work' },
  { href: '/insights', label: 'Insights' },
  { href: '/about', label: 'About' },
];

function isCurrent(href: string): boolean {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="page site-header-inner">
    <a class="wordmark" href="/" aria-label={`${site.brandName} home`}>
      <span class="wordmark-mark" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="18" height="18" focusable="false">
          <path
            d="M10 1.5 2.8 4.4v5.3c0 4.1 2.9 7.4 7.2 8.8 4.3-1.4 7.2-4.7 7.2-8.8V4.4L10 1.5Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"></path>
          <path d="M7 10.1 9.2 12.3 13.4 8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="wordmark-text">{site.wordmark}</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header-actions">
      <button type="button" class="search-trigger" data-command-trigger aria-label="Search this site">
        <span aria-hidden="true">Search</span>
        <kbd>⌘K</kbd>
      </button>
      <a class="button" href="/contact">Book a scoping call</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--ground);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    min-height: 4.25rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    flex: none;
  }

  .wordmark-mark {
    color: var(--accent);
    display: inline-flex;
  }

  nav ul {
    display: flex;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  nav li {
    max-width: none;
  }

  nav a {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .site-header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: var(--step--1);
    padding: 0.42rem 0.7rem;
    cursor: pointer;
  }

  .search-trigger:hover {
    border-color: var(--rule-strong);
    color: var(--ink-muted);
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    border: 1px solid var(--rule);
    padding: 0 0.25rem;
  }

  @media (max-width: 62rem) {
    .site-header {
      position: static;
    }
    .site-header-inner {
      flex-wrap: wrap;
      gap: var(--space-s);
      padding-block: var(--space-s);
    }
    .site-header-actions {
      margin-left: 0;
      width: 100%;
    }
    .search-trigger kbd {
      display: none;
    }
  }
</style>
